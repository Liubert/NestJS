# App
APP_PORT=3000
APP_NAME=nest_js
NODE_ENV=prod

# CORS: comma-separated allowed origins (empty = allow all, for dev only)
CORS_ORIGINS=http://localhost:3010,http://localhost:3001

# Auth
JWT_SECRET=change-me

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ecom
DB_USER=postgres
DB_PASS=change-me

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Admin UI (optional, default 3001)
# ADMIN_UI_PORT=3010

# AI Translation (Gemini)
GEMINI_API_KEY=your-gemini-api-key

# AWS (optional)
AWS_REGION=eu-north-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
