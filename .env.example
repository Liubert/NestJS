# App
APP_PORT=3000
APP_NAME=Locale-Engine
NODE_ENV=production

# CORS: comma-separated allowed origins (empty = allow all)
CORS_ORIGINS=

# Auth
JWT_SECRET=change-me

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ecom
DB_USER=postgres
DB_PASS=change-me

# Docker image name
APP_IMAGE=locale-engine:local

# AI Translation (Gemini)
GEMINI_API_KEY=your-gemini-api-key

# Admin UI
ADMIN_UI_PORT=3010
