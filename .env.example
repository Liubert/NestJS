# App
APP_PORT=3000
APP_NAME=nest_js
NODE_ENV=prod

# CORS: comma-separated allowed origins (empty = allow all, for dev only)
CORS_ORIGINS=http://localhost:3010,http://localhost:3001

# Auth
JWT_SECRET=change-me

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ecom
DB_USER=postgres
DB_PASS=change-me

# AI Translation (Gemini)
GEMINI_API_KEY=your-gemini-api-key

# Admin UI (optional, default 3001)
# ADMIN_UI_PORT=3010
