# URL of the localization backend API
BACKEND_URL=http://localhost:8080

# MCP token for backend authentication (generated in Admin UI → Settings → MCP Tokens)
MCP_TOKEN=lmcp_your-token-here

# Admin UI URL — used by the agent to provide correct links to the user
ADMIN_UI_URL=http://localhost:3010

# Path for the write-operation audit log (optional, defaults to ./mcp-audit.log)
# AUDIT_LOG_PATH=/var/log/localization-mcp-audit.log
