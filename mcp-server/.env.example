# ─── REQUIRED ─────────────────────────────────────────────────────────────────
# Both variables MUST be set. The server will warn loudly if they are missing.

# URL of the localization backend API.
# IMPORTANT: This must match the environment you intend to work with.
# - Development: http://localhost:8080
# - Staging:     http://your-stage-server:8080
# - Production:  https://your-prod-server
# Never leave this unset — the server falls back to localhost:8080 which may
# silently target the wrong environment.
BACKEND_URL=http://localhost:8080

# MCP token for backend authentication.
# Generate in Admin UI → Settings → MCP Tokens.
MCP_TOKEN=lmcp_your-token-here

# ─── OPTIONAL ─────────────────────────────────────────────────────────────────

# Admin UI URL — used to provide correct links in tool responses.
# Must match the environment above (dev/stage/prod).
ADMIN_UI_URL=http://localhost:3010

# Path for the write-operation audit log (defaults to ./mcp-audit.log)
# AUDIT_LOG_PATH=/var/log/localization-mcp-audit.log
