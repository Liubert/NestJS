{
  "name": "localization-mcp-server",
  "version": "1.3.0",
  "description": "MCP server for the localization system — controlled AI access to translations",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "localization-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "flows",
    ".env.example",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "localization",
    "translations"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "i18next-http-backend": "^3.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
