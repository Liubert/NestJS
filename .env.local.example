# ──────────────────────────────────────────────────────────────────
# .env.local.example — local development (no Docker) environment
# Copy to .env.local and adjust values as needed.
# dev.sh reads .env.local first, falling back to .env if missing.
# ──────────────────────────────────────────────────────────────────

# App
APP_PORT=7000
APP_NAME=nest_js
NODE_ENV=development

# Auth
JWT_SECRET=local-dev-secret

# Database — localhost defaults (Homebrew PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecom
DB_USER=postgres
DB_PASS=postgres

# RabbitMQ — not used by the app currently.
# Uncomment if RabbitMQ features are re-enabled.
# RABBITMQ_URL=amqp://guest:guest@localhost:5672

# AI Translation (Gemini) — optional, leave placeholder if not needed
GEMINI_API_KEY=your-gemini-api-key

# AWS (optional)
AWS_REGION=eu-north-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
